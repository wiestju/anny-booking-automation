# ── Required ─────────────────────────────────────────────────────────────────
USERNAME="username"
PASSWORD="password"

# ── Provider ─────────────────────────────────────────────────────────────────
SSO_PROVIDER="kit"           # Available: "kit", "tum" (add more in auth/providers/)
# TUM example:
# SSO_PROVIDER="tum"

# Resource config is optional — if unset, all bookable floors are auto-discovered.
# Set these only to pin a single resource/building.
# RESOURCE_URL_PATH="/resources/1-lehrbuchsammlung-eg-und-1-og/children"
# SERVICE_ID="449"

# ── Booking strategy ─────────────────────────────────────────────────────────
# BOOKING_MODE="opening"     # "opening" = book at each floor's real opening time
#                            # (recommended); "immediate" = book what's free now
# BOOK_DAYS_AHEAD="4"        # book the day this many days ahead
BOOKING_TIMES="14:00:00-19:00:00, 09:00:00-13:00:00, 20:00:00-23:45:00"

# ── Floor & seat preferences (all optional) ──────────────────────────────────
# FLOORS=""                  # empty = all floors; else priority list, e.g. "lehrbuchsammlung"
# PREFERRED_RESOURCES=""     # favorite seats tried first, e.g. "A1.007"
# USE_ANNY_FAVORITES="True"  # also auto-prioritize seats/floors starred in anny

# ── Misc ─────────────────────────────────────────────────────────────────────
# TIMEZONE="Europe/Berlin"
# SNIPE_ACTIVATE_MIN="20"    # opening mode: wake up only within N min of an opening
# DEBUG="False"
